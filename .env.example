# Cấu hình môi trường ứng dụng ORGO
# Sao chép file này thành .env và điền các giá trị thực

# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/orgo

# JWT Secret (thay bằng chuỗi ngẫu nhiên dài ít nhất 32 ký tự)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Session Secret
SESSION_SECRET=your_session_secret_here

# Gmail (dùng cho gửi OTP)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Cloudinary (upload ảnh - tuỳ chọn)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

