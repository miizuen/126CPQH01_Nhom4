<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' | ORGO Organic' : 'Tài khoản cá nhân | ORGO' %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/png" href="/images/logo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&family=Lora:ital,wght@0,500;0,600;0,700;1,400;1,500;1,600&family=Playfair+Display:ital,wght@0,600;0,700;1,500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    .user-nav-link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 18px;
      border-radius: 14px;
      font-size: 14.5px;
      font-weight: 600;
      color: #334155;
      text-decoration: none;
      transition: all 0.22s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .user-nav-link svg {
      color: #64748b;
      transition: all 0.22s ease;
      flex-shrink: 0;
    }

    .user-nav-link:hover {
      background: #f1f8f3;
      color: #16301f;
      transform: translateX(4px);
    }

    .user-nav-link:hover svg {
      color: #256b40;
    }

    .user-nav-link.active {
      background: #16301f;
      color: #ffffff;
      font-weight: 700;
      box-shadow: 0 4px 16px rgba(22, 48, 31, 0.2);
    }

    .user-nav-link.active svg {
      color: #86efac;
    }
  </style>
</head>
<body style="background-color: #f7f5f0;">

  <!-- ─── HEADER / NAVBAR ─────────────────────────────────────────────── -->
  <header class="header">
    <div class="container navbar">
      <a href="/" class="brand-logo">
        <img src="/images/logo.png" alt="ORGO Organic Logo" class="logo-img">
        <div class="brand-text">
          <span class="brand-name">ORGO</span>
          <span class="brand-sub">ORGANIC</span>
        </div>
      </a>

      <!-- Search bar -->
      <form action="/shop" method="GET" class="search-box">
        <span class="icon">🔍</span>
        <input type="text" name="q" placeholder="Tìm kiếm nông sản, thực phẩm sạch...">
      </form>

      <!-- Nav links -->
      <ul class="nav-links">
        <li><a href="/">Trang chủ</a></li>
        <li><a href="/shop">Cửa hàng</a></li>
        <li><a href="/blog">Cẩm nang Organic</a></li>
      </ul>

      <!-- Action buttons -->
      <div class="nav-actions">
        <a href="/cart" class="cart-btn" id="headerCartBtn">
          <span>🛒 Giỏ hàng</span>
          <span class="cart-badge" id="headerCartBadge" style="display: none; background: #c2410c; color: #fff; font-size: 11px; font-weight: 700; padding: 2px 7px; border-radius: 9999px;">0</span>
        </a>

        <% if (locals.user) { %>
          <div style="display: flex; align-items: center; gap: 8px;">
            <% if (user.role === 'SELLER') { %>
              <a href="/seller/dashboard" class="btn btn-primary btn-sm" style="background: #16301f; border-color: #16301f; padding: 6px 12px; font-size: 12.5px;">
                🏪 Kênh Bán
              </a>
            <% } else if (user.role === 'ADMIN') { %>
              <a href="/admin" class="btn btn-primary btn-sm" style="background: #16301f; border-color: #16301f; padding: 6px 12px; font-size: 12.5px;">
                ⚙️ Quản Trị
              </a>
            <% } else if (user.role === 'EXPERT') { %>
              <a href="/expert" class="btn btn-primary btn-sm" style="background: #16301f; border-color: #16301f; padding: 6px 12px; font-size: 12.5px;">
                ✍️ Viết Bài
              </a>
            <% } %>

            <a href="/user/profile" class="btn btn-outline btn-sm" style="background: #ffffff; padding: 6px 14px; font-size: 13px; font-weight: 600; border: 1.5px solid #16301f; color: #16301f;">
              👤 <%= user.fullName ? user.fullName.split(' ').slice(-1)[0] : 'Tài khoản' %>
            </a>

            <a href="/auth/logout" title="Đăng xuất" style="display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 50%; border: 1px solid #fed7aa; color: #dc2626; font-size: 14px; transition: all 0.2s;" onmouseover="this.style.background='#fee2e2'" onmouseout="this.style.background='transparent'">
              🚪
            </a>
          </div>
        <% } else { %>
          <a href="/auth/login" class="btn btn-outline btn-sm">Đăng nhập</a>
          <a href="/auth/register" class="btn btn-primary btn-sm">Đăng ký</a>
        <% } %>
      </div>
    </div>
  </header>

  <!-- ─── BREADCRUMB / HERO BANNER ───────────────────────────────────── -->
  <section style="background: linear-gradient(135deg, #16301f 0%, #1e4028 100%); padding: 32px 0; color: #ffffff; border-bottom: 1px solid rgba(255,255,255,0.1);">
    <div class="container" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
      <div>
        <div style="font-size: 13px; color: #86efac; font-weight: 600; margin-bottom: 6px; display: flex; align-items: center; gap: 8px;">
          <a href="/" style="color: #86efac; text-decoration: none;">Trang chủ</a>
          <span style="opacity: 0.6;">/</span>
          <span style="color: rgba(255,255,255,0.85);">Tài khoản thành viên</span>
          <span style="opacity: 0.6;">/</span>
          <span style="color: #ffffff;"><%= typeof title !== 'undefined' ? title.replace(' – ORGO', '').replace(' | ORGO', '') : 'Thông tin cá nhân' %></span>
        </div>
        <h1 style="font-family: 'Lora', Georgia, serif; font-size: 26px; font-weight: 700; color: #ffffff; margin: 0; letter-spacing: -0.3px;">
          Tài Khoản & Hồ Sơ Thành Viên
        </h1>
      </div>

      <div style="display: flex; align-items: center; gap: 12px; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); padding: 8px 18px; border-radius: 9999px;">
        <span style="width: 10px; height: 10px; border-radius: 50%; background: #4ade80; box-shadow: 0 0 8px #4ade80;"></span>
        <span style="font-size: 13px; font-weight: 600; color: #ffffff;">Hội viên Organic Verified</span>
      </div>
    </div>
  </section>

  <!-- ─── MAIN DASHBOARD CONTENT ──────────────────────────────────────── -->
  <div class="container" style="padding: 36px 20px 70px;">
    <% if (locals.success && success.length) { %>
      <div style="background: #ecfdf5; border: 1.5px solid #a7f3d0; color: #065f46; border-radius: 14px; padding: 14px 20px; margin-bottom: 24px; display: flex; align-items: center; gap: 12px; font-size: 14.5px; font-weight: 600; box-shadow: 0 2px 10px rgba(16, 185, 129, 0.08);">
        <span style="font-size: 18px;">✅</span> <span><%= success %></span>
      </div>
    <% } %>
    <% if (locals.error && error.length) { %>
      <div style="background: #fef2f2; border: 1.5px solid #fecaca; color: #991b1b; border-radius: 14px; padding: 14px 20px; margin-bottom: 24px; display: flex; align-items: center; gap: 12px; font-size: 14.5px; font-weight: 600; box-shadow: 0 2px 10px rgba(239, 68, 68, 0.08);">
        <span style="font-size: 18px;">⚠️</span> <span><%= error %></span>
      </div>
    <% } %>

    <div style="display: grid; grid-template-columns: 280px 1fr; gap: 32px; align-items: flex-start;">
      <!-- Sidebar tài khoản -->
      <aside style="background: #ffffff; border-radius: 20px; border: 1px solid #e9e4db; padding: 28px 20px; box-shadow: 0 4px 24px rgba(22, 48, 31, 0.05);">
        <!-- Avatar & User Info -->
        <div style="text-align: center; margin-bottom: 24px; padding-bottom: 22px; border-bottom: 1px solid #f1ece4;">
          <div style="position: relative; width: 80px; height: 80px; margin: 0 auto 14px;">
            <div style="width: 100%; height: 100%; border-radius: 50%; background: linear-gradient(135deg, #16301f 0%, #256b40 100%); color: #ffffff; font-weight: 800; font-size: 30px; display: flex; align-items: center; justify-content: center; box-shadow: 0 6px 18px rgba(22, 48, 31, 0.25); border: 3px solid #ffffff;">
              <%= locals.user && locals.user.fullName ? locals.user.fullName.charAt(0).toUpperCase() : 'U' %>
            </div>
            <span style="position: absolute; bottom: 0; right: 0; background: #22c55e; color: #ffffff; width: 22px; height: 22px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; border: 2px solid #ffffff;" title="Đã xác thực">✓</span>
          </div>

          <h3 style="font-size: 17px; font-weight: 700; color: #0f172a; margin-bottom: 4px;">
            <%= locals.user ? locals.user.fullName : 'Thành viên ORGO' %>
          </h3>
          <p style="font-size: 12.5px; color: #64748b; margin-bottom: 10px; word-break: break-all;">
            <%= locals.user ? locals.user.email : '' %>
          </p>

          <span style="display: inline-block; background: #eaf6ee; color: #166534; font-size: 11.5px; font-weight: 700; padding: 4px 12px; border-radius: 9999px; border: 1px solid #bbf7d0;">
            🌿 Hội viên thân thiết
          </span>
        </div>

        <!-- Navigation Links -->
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 8px; margin: 0; padding: 0;">
          <li>
            <a href="/user/orders" class="user-nav-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/>
                <path d="m3.3 7 8.7 5 8.7-5"/>
                <path d="M12 22V12"/>
              </svg>
              <span>Đơn hàng của tôi</span>
            </a>
          </li>

          <li>
            <a href="/user/profile" class="user-nav-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="5"/>
                <path d="M20 21a8 8 0 1 0-16 0"/>
              </svg>
              <span>Thông tin tài khoản</span>
            </a>
          </li>

          <li>
            <a href="/cart" class="user-nav-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="8" cy="21" r="1"/>
                <circle cx="19" cy="21" r="1"/>
                <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>
              </svg>
              <span>Giỏ hàng</span>
            </a>
          </li>

          <li style="margin-top: 10px; padding-top: 10px; border-top: 1px dashed #e2e8f0;">
            <a href="/auth/logout" class="user-nav-link" style="color: #dc2626;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16 17 21 12 16 7"/>
                <line x1="21" x2="9" y1="12" y2="12"/>
              </svg>
              <span>Đăng xuất</span>
            </a>
          </li>
        </ul>

        <!-- Support Info Box -->
        <div style="margin-top: 24px; padding: 16px; background: #faf9f5; border-radius: 14px; border: 1px solid #eee8dd; text-align: center;">
          <div style="font-size: 20px; margin-bottom: 6px;">🎧</div>
          <div style="font-size: 12.5px; font-weight: 700; color: #16301f; margin-bottom: 2px;">Hỗ trợ khách hàng</div>
          <div style="font-size: 11.5px; color: #64748b; margin-bottom: 8px;">Tư vấn nông sản sạch 24/7</div>
          <a href="tel:19008888" style="font-size: 13px; font-weight: 800; color: #c2410c; text-decoration: none;">📞 1900 8888</a>
        </div>
      </aside>

      <!-- Nội dung chính -->
      <main style="background: #ffffff; border-radius: 20px; border: 1px solid #e9e4db; padding: 36px; box-shadow: 0 4px 24px rgba(22, 48, 31, 0.05); min-width: 0;">
        <%- body %>
      </main>
    </div>
  </div>

  <!-- ─── FOOTER ──────────────────────────────────────────────────────── -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col">
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
            <img src="/images/logo.png" alt="ORGO Logo" style="width: 48px; height: 48px; border-radius: 50%; background: #ffffff; padding: 2px; box-shadow: 0 2px 8px rgba(0,0,0,0.2);">
            <div>
              <h4 style="font-size: 20px; margin-bottom: 0;">ORGO ORGANIC</h4>
              <span style="font-size: 11px; letter-spacing: 1px; color: var(--primary-light);">THỰC PHẨM XANH SẠCH</span>
            </div>
          </div>
          <p>Hệ thống sàn thương mại điện tử chuyên cung cấp thực phẩm hữu cơ 100% đạt chuẩn chứng nhận VietGAP, USDA Organic và EU Organic.</p>
          <p style="margin-top: 12px; font-size: 12px; color: #94a3b8;">
            Đồ án TMĐT - Nhóm SNSD: <strong>Võ Đức Phú</strong> & <strong>Bạch Ngọc Mỹ Duyên</strong>
          </p>
        </div>

        <div class="footer-col">
          <h4>Danh Mục</h4>
          <ul class="footer-links">
            <li><a href="/shop?cat=rau-cu">Rau củ tươi sạch</a></li>
            <li><a href="/shop?cat=trai-cay">Trái cây hữu cơ</a></li>
            <li><a href="/shop?cat=thit-trung">Thịt & Trứng sạch</a></li>
            <li><a href="/shop?cat=ngu-coc">Ngũ cốc & Hạt dinh dưỡng</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4>Về Chúng Tôi</h4>
          <ul class="footer-links">
            <li><a href="/blog">Cẩm nang sống xanh</a></li>
            <li><a href="/auth/register">Đăng ký bán hàng</a></li>
            <li><a href="/shop">Tiêu chuẩn Organic</a></li>
            <li><a href="#">Chính sách đổi trả</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4>Liên Hệ & Hỗ Trợ</h4>
          <p>📍 Đà Nẵng, Việt Nam</p>
          <p>📞 Hotline: 1900 8888</p>
          <p>✉️ Email: voducphu1912005@gmail.com</p>
        </div>
      </div>

      <div class="footer-bottom">
        <p>© 2026 ORGO Organic System. Xây dựng với Node.js, Express & MongoDB.</p>
      </div>
    </div>
  </footer>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const currentPath = window.location.pathname;
      document.querySelectorAll(".user-nav-link").forEach(link => {
        const href = link.getAttribute("href");
        if (href === currentPath || (currentPath.startsWith('/user/orders') && href === '/user/orders')) {
          link.classList.add("active");
        }
      });
    });
  </script>
</body>
</html>
