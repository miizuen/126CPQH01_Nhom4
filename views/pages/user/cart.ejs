<div class="container" style="padding-top: 30px; padding-bottom: 60px;">
  <h1 style="font-size: 28px; font-weight: 800; color: var(--dark); margin-bottom: 24px;">Giỏ Hàng Của Bạn</h1>

  <% if (typeof cart !== 'undefined' && cart.items && cart.items.length) { %>
    <div style="display: grid; grid-template-columns: 1.8fr 1fr; gap: 30px; align-items: flex-start;">
      <!-- Danh sách món hàng -->
      <div style="background: var(--white); border-radius: var(--radius-md); border: 1px solid var(--gray-200); padding: 24px;">
        <table style="width: 100%; border-collapse: collapse;">
          <thead>
            <tr style="border-bottom: 1.5px solid var(--gray-200); text-align: left; font-size: 13px; color: var(--gray-500);">
              <th style="padding-bottom: 12px;">Sản phẩm</th>
              <th style="padding-bottom: 12px;">Đơn giá</th>
              <th style="padding-bottom: 12px; text-align: center;">Số lượng</th>
              <th style="padding-bottom: 12px; text-align: right;">Tạm tính</th>
              <th style="padding-bottom: 12px;"></th>
            </tr>
          </thead>
          <tbody>
            <% let subtotal = 0; %>
            <% cart.items.forEach(item => { %>
              <% const itemTotal = (item.price || 0) * (item.quantity || 1); subtotal += itemTotal; %>
              <tr style="border-bottom: 1px solid var(--gray-200);">
                <td style="padding: 16px 0; display: flex; align-items: center; gap: 14px;">
                  <img src="<%= item.product && item.product.images && item.product.images[0] ? item.product.images[0] : 'https://images.unsplash.com/photo-1540420773420-3366772f4999?auto=format&fit=crop&w=100&q=80' %>" style="width: 56px; height: 56px; border-radius: var(--radius-sm); object-fit: cover;">
                  <div>
                    <strong style="font-size: 14px; color: var(--dark);"><%= item.product ? item.product.name : 'Sản phẩm' %></strong>
                    <div style="font-size: 12px; color: var(--gray-500);"><%= item.variantName || '' %></div>
                  </div>
                </td>
                <td style="padding: 16px 0; font-size: 14px; font-weight: 600;"><%= item.price ? item.price.toLocaleString('vi-VN') : 0 %>đ</td>
                <td style="padding: 16px 0; text-align: center; font-size: 14px; font-weight: 700;"><%= item.quantity %></td>
                <td style="padding: 16px 0; text-align: right; font-size: 14px; font-weight: 700; color: var(--primary-dark);"><%= itemTotal.toLocaleString('vi-VN') %>đ</td>
                <td style="padding: 16px 0; text-align: right;">
                  <form action="/cart/remove" method="POST" style="margin: 0;">
                    <input type="hidden" name="itemId" value="<%= item._id %>">
                    <button type="submit" style="background: none; border: none; color: var(--danger); cursor: pointer; font-size: 16px;">🗑️</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- Tóm tắt đơn hàng -->
      <div style="background: var(--white); border-radius: var(--radius-md); border: 1px solid var(--gray-200); padding: 24px;">
        <h3 style="font-size: 18px; font-weight: 800; color: var(--dark); margin-bottom: 20px;">Tóm Tắt Đơn Hàng</h3>

        <div style="display: flex; justify-content: space-between; margin-bottom: 12px; font-size: 14px;">
          <span>Tiền hàng:</span>
          <strong><%= subtotal.toLocaleString('vi-VN') %>đ</strong>
        </div>

        <div style="display: flex; justify-content: space-between; margin-bottom: 16px; font-size: 14px;">
          <span>Phí vận chuyển dự kiến:</span>
          <strong>30.000đ</strong>
        </div>

        <div style="border-top: 1.5px dashed var(--gray-200); padding-top: 16px; margin-bottom: 24px; display: flex; justify-content: space-between; align-items: baseline;">
          <span style="font-size: 16px; font-weight: 700; color: var(--dark);">Tổng thanh toán:</span>
          <span style="font-size: 24px; font-weight: 800; color: var(--primary-dark);"><%= (subtotal + 30000).toLocaleString('vi-VN') %>đ</span>
        </div>

        <a href="/checkout" class="btn btn-primary btn-lg" style="width: 100%; border-radius: var(--radius-sm); text-align: center;">
          Tiến Hành Đặt Hàng →
        </a>

        <a href="/shop" class="btn btn-outline btn-sm" style="width: 100%; border-radius: var(--radius-sm); text-align: center; margin-top: 12px;">
          ← Tiếp tục chọn hàng
        </a>
      </div>
    </div>
  <% } else { %>
    <div style="text-align: center; padding: 80px 20px; background: var(--white); border-radius: var(--radius-md); border: 1px solid var(--gray-200);">
      <div style="font-size: 56px; margin-bottom: 16px;">🛒</div>
      <h3 style="font-size: 20px; color: var(--dark); margin-bottom: 8px;">Giỏ hàng của bạn đang trống</h3>
      <p style="color: var(--gray-500); font-size: 14px; margin-bottom: 24px;">Hãy khám phá các loại rau củ quả tươi sạch thơm ngon tại ORGO!</p>
      <a href="/shop" class="btn btn-primary btn-lg">Khám phá cửa hàng ngay</a>
    </div>
  <% } %>
</div>
