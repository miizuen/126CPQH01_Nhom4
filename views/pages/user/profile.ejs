<style>
  :root {
    --pro-forest: #14382c;
    --pro-sage: #2d6a4f;
    --pro-sand: #fbf9f5;
    --pro-border: #e8e2d5;
    --pro-clay: #d97706;
  }

  .profile-wrap {
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
  }

  /* Natural Ambient Cover */
  .profile-cover {
    background: linear-gradient(135deg, #123326 0%, #1c4736 60%, #295e48 100%);
    border-radius: 28px;
    padding: 38px 44px;
    color: #ffffff;
    margin-bottom: 36px;
    position: relative;
    overflow: hidden;
    box-shadow: 0 16px 36px rgba(18, 51, 38, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .profile-cover::after {
    content: '';
    position: absolute;
    right: -20px; top: -20px;
    width: 200px; height: 200px;
    background: radial-gradient(circle, rgba(134, 239, 172, 0.18) 0%, transparent 70%);
    border-radius: 50%;
  }

  /* Form Card Layout */
  .profile-card {
    background: #ffffff;
    border-radius: 24px;
    border: 1px solid var(--pro-border);
    box-shadow: 0 10px 30px -5px rgba(20, 56, 44, 0.05);
    padding: 36px 40px;
    margin-bottom: 32px;
  }

  .profile-input-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .profile-input-group label {
    font-size: 13.5px;
    font-weight: 700;
    color: #334155;
  }
  .profile-input-wrapper {
    position: relative;
  }
  .profile-input-wrapper input {
    width: 100%;
    padding: 13px 18px 13px 44px;
    border: 1.5px solid #cbd5e1;
    border-radius: 14px;
    font-size: 15px;
    outline: none;
    transition: all 0.2s;
    font-family: inherit;
    background: #ffffff;
    color: #1e293b;
  }
  .profile-input-wrapper input:focus {
    border-color: var(--pro-sage);
    box-shadow: 0 0 0 4px rgba(45, 106, 79, 0.12);
  }
  .profile-input-icon {
    position: absolute;
    left: 15px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 18px;
    color: #64748b;
    pointer-events: none;
  }
</style>

<div class="profile-wrap">

  <!-- ─── 1. NATURAL PROFILE HERO ──────────────────────────────────────── -->
  <div class="profile-cover">
    <div style="position: relative; z-index: 2; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 24px;">
      
      <div style="display: flex; align-items: center; gap: 24px;">
        <!-- Avatar Ring -->
        <div style="width: 84px; height: 84px; border-radius: 50%; background: linear-gradient(135deg, #eab308 0%, #22c55e 100%); padding: 3px; box-shadow: 0 8px 24px rgba(0,0,0,0.25);">
          <div style="width: 100%; height: 100%; border-radius: 50%; background: #123326; display: flex; align-items: center; justify-content: center; font-size: 36px; font-weight: 700; color: #86efac; font-family: 'Playfair Display', serif;">
            <%= pageUser.fullName ? pageUser.fullName.charAt(0).toUpperCase() : 'U' %>
          </div>
        </div>

        <div>
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 6px;">
            <h1 style="font-family: 'Playfair Display', serif; font-size: 28px; font-weight: 700; margin: 0; color: #fff;">
              <%= pageUser.fullName %>
            </h1>
            <span style="background: rgba(234, 179, 8, 0.25); color: #fef08a; font-size: 11px; font-weight: 800; padding: 4px 12px; border-radius: 20px; border: 1px solid rgba(234, 179, 8, 0.4); text-transform: uppercase; letter-spacing: 0.8px;">
              ★ <%= pageUser.role || 'THÀNH VIÊN' %>
            </span>
          </div>
          <p style="margin: 0; color: #cbd5e1; font-size: 14.5px; display: flex; align-items: center; gap: 8px;">
            <span>✉️ <%= pageUser.email %></span>
            <span>•</span>
            <span style="color: #86efac; font-weight: 600;">Hội viên tiêu dùng xanh ORGO</span>
          </p>
        </div>
      </div>

      <!-- Eco Points & Level -->
      <div style="display: flex; gap: 16px; background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(8px); padding: 14px 22px; border-radius: 20px; border: 1px solid rgba(255, 255, 255, 0.18);">
        <div style="text-align: center; border-right: 1px solid rgba(255,255,255,0.2); padding-right: 18px;">
          <div style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.8px; color: #cbd5e1; font-weight: 700;">Hạng Hội Viên</div>
          <div style="font-size: 16px; font-weight: 800; color: #fef08a; margin-top: 3px;">🌿 Nông Trại Xanh</div>
        </div>
        <div style="text-align: center;">
          <div style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.8px; color: #cbd5e1; font-weight: 700;">Điểm Eco Tích Lũy</div>
          <div style="font-size: 16px; font-weight: 800; color: #86efac; margin-top: 3px;">+240 Điểm</div>
        </div>
      </div>

    </div>
  </div>

  <!-- ─── 2. CONTACT & SHIPPING FORM ───────────────────────────────────── -->
  <div class="profile-card">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 26px; padding-bottom: 18px; border-bottom: 1px solid var(--pro-border);">
      <div>
        <h3 style="font-family: 'Playfair Display', serif; font-size: 21px; font-weight: 700; color: var(--pro-forest); margin: 0;">
          Thông Tin Cá Nhân & Nhận Hàng
        </h3>
        <p style="font-size: 13.5px; color: #64748b; margin: 4px 0 0 0;">
          Dùng để liên hệ giao hàng nông sản tươi tận nơi và gửi tin nhắn cập nhật đơn xe lạnh
        </p>
      </div>
      <span style="font-size: 12.5px; color: #166534; background: #f0fdf4; border: 1px solid #bbf7d0; padding: 5px 14px; border-radius: 20px; font-weight: 700;">
        ✓ Thông tin chuẩn xác
      </span>
    </div>

    <form action="/user/profile" method="POST">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; margin-bottom: 26px;">
        
        <div class="profile-input-group">
          <label for="fullName">Họ và tên người nhận <span style="color: #dc2626;">*</span></label>
          <div class="profile-input-wrapper">
            <span class="profile-input-icon">👤</span>
            <input type="text" id="fullName" name="fullName" value="<%= pageUser.fullName %>" required placeholder="Họ và tên của bạn">
          </div>
        </div>

        <div class="profile-input-group">
          <label for="phone">Số điện thoại giao hàng <span style="color: #dc2626;">*</span></label>
          <div class="profile-input-wrapper">
            <span class="profile-input-icon">📞</span>
            <input type="tel" id="phone" name="phone" value="<%= pageUser.phone || '' %>" placeholder="09xx xxx xxx">
          </div>
        </div>

        <div class="profile-input-group">
          <label for="email">Địa chỉ Email đăng nhập</label>
          <div class="profile-input-wrapper">
            <span class="profile-input-icon">✉️</span>
            <input type="email" id="email" value="<%= pageUser.email %>" disabled style="background: #f8fafc; color: #64748b; cursor: not-allowed;">
          </div>
        </div>

        <div class="profile-input-group">
          <label for="address">Địa chỉ nhà (Số nhà, Phường/Xã, Quận/Huyện)</label>
          <div class="profile-input-wrapper">
            <span class="profile-input-icon">📍</span>
            <input type="text" id="address" name="address" value="<%= pageUser.address || '' %>" placeholder="Số nhà, ngõ/đường, khu vực...">
          </div>
        </div>

      </div>

      <div style="display: flex; justify-content: flex-end;">
        <button type="submit" style="background: var(--pro-sage); color: #fff; font-weight: 700; font-size: 14.5px; padding: 13px 30px; border-radius: 30px; border: none; cursor: pointer; box-shadow: 0 6px 18px rgba(45, 106, 79, 0.28); transition: all 0.2s;" onmouseover="this.style.background='#22543d'; this.style.transform='translateY(-2px)'" onmouseout="this.style.background='var(--pro-sage)'; this.style.transform=''">
          💾 Cập Nhật Hồ Sơ
        </button>
      </div>
    </form>
  </div>

  <!-- ─── 3. SECURITY / PASSWORD CARD ─────────────────────────────────── -->
  <div class="profile-card">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 26px; padding-bottom: 18px; border-bottom: 1px solid var(--pro-border);">
      <div>
        <h3 style="font-family: 'Playfair Display', serif; font-size: 21px; font-weight: 700; color: var(--pro-forest); margin: 0;">
          Mật Khẩu & Bảo Mật
        </h3>
        <p style="font-size: 13.5px; color: #64748b; margin: 4px 0 0 0;">
          Bảo vệ tài khoản và lịch sử giao dịch nông sản của gia đình bạn
        </p>
      </div>
      <span style="font-size: 18px;">🔒</span>
    </div>

    <form action="/user/change-password" method="POST">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; margin-bottom: 26px;">
        
        <div class="profile-input-group">
          <label for="currentPassword">Mật khẩu hiện tại</label>
          <input type="password" id="currentPassword" name="currentPassword" required placeholder="••••••••" style="padding: 13px 18px; border: 1.5px solid #cbd5e1; border-radius: 14px; font-size: 15px; outline: none;">
        </div>

        <div class="profile-input-group">
          <label for="newPassword">Mật khẩu mới</label>
          <input type="password" id="newPassword" name="newPassword" required placeholder="Tối thiểu 6 ký tự" style="padding: 13px 18px; border: 1.5px solid #cbd5e1; border-radius: 14px; font-size: 15px; outline: none;">
        </div>

        <div class="profile-input-group">
          <label for="confirmPassword">Xác nhận mật khẩu</label>
          <input type="password" id="confirmPassword" name="confirmPassword" required placeholder="••••••••" style="padding: 13px 18px; border: 1.5px solid #cbd5e1; border-radius: 14px; font-size: 15px; outline: none;">
        </div>

      </div>

      <div style="display: flex; justify-content: flex-end;">
        <button type="submit" style="background: #ffffff; color: var(--pro-forest); font-weight: 700; font-size: 14px; padding: 12px 26px; border-radius: 30px; border: 1.5px solid #cbd5e1; cursor: pointer; transition: all 0.2s;" onmouseover="this.style.borderColor='var(--pro-sage)'; this.style.color='var(--pro-sage)'" onmouseout="this.style.borderColor='#cbd5e1'; this.style.color='var(--pro-forest)'">
          🛡️ Đổi Mật Khẩu
        </button>
      </div>
    </form>
  </div>

</div>
