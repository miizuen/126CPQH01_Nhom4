<div class="container" style="padding-top: 40px; padding-bottom: 80px; text-align: center;">
  <div style="max-width: 600px; margin: 0 auto; background: var(--white); border-radius: var(--radius-lg); border: 1px solid var(--gray-200); padding: 48px; box-shadow: var(--shadow-md);">
    
    <div style="font-size: 64px; margin-bottom: 16px;">🎉</div>
    <h1 style="font-size: 28px; font-weight: 800; color: var(--dark); margin-bottom: 10px;">Đặt Hàng Thành Công!</h1>
    <p style="color: var(--gray-500); font-size: 15px; margin-bottom: 24px;">
      Cảm ơn bạn đã tin tưởng lựa chọn thực phẩm hữu cơ ORGO. Đơn hàng của bạn đang được các nhà vườn chuẩn bị.
    </p>

    <div style="background: var(--bg-light); border-radius: var(--radius-md); padding: 20px; text-align: left; margin-bottom: 28px; border: 1px solid var(--gray-200);">
      <div style="display: flex; justify-content: space-between; margin-bottom: 10px; font-size: 14px;">
        <span>Mã đơn hàng:</span>
        <strong>#<%= order._id.toString().slice(-8).toUpperCase() %></strong>
      </div>
      <div style="display: flex; justify-content: space-between; margin-bottom: 10px; font-size: 14px;">
        <span>Phương thức:</span>
        <strong><%= order.paymentMethod === 'COD' ? '💵 Thanh toán khi nhận hàng' : '🏦 Chuyển khoản ngân hàng' %></strong>
      </div>
      <div style="display: flex; justify-content: space-between; font-size: 16px; border-top: 1px dashed var(--gray-200); padding-top: 10px;">
        <span style="font-weight: 700;">Tổng thanh toán:</span>
        <strong style="color: var(--primary-dark); font-size: 18px;"><%= order.total ? order.total.toLocaleString('vi-VN') : 0 %>đ</strong>
      </div>
    </div>

    <% if (order.paymentMethod === 'BANK_TRANSFER') { %>
      <div style="background: var(--primary-subtle); border: 1.5px solid var(--primary-light); border-radius: var(--radius-md); padding: 20px; text-align: left; margin-bottom: 28px;">
        <h4 style="color: var(--primary-dark); margin-bottom: 8px;">🏦 Thông Tin Chuyển Khoản Ngân Hàng</h4>
        <p style="font-size: 13.5px; color: var(--gray-700); margin-bottom: 8px;">Ngân hàng: <strong>MB Bank (Quân Đội)</strong></p>
        <p style="font-size: 13.5px; color: var(--gray-700); margin-bottom: 8px;">Số tài khoản: <strong>090123456789</strong></p>
        <p style="font-size: 13.5px; color: var(--gray-700); margin-bottom: 8px;">Chủ tài khoản: <strong>VO DUC PHU</strong></p>
        <p style="font-size: 13.5px; color: var(--primary-dark);">Nội dung CK: <strong>ORGO <%= order._id.toString().slice(-8).toUpperCase() %></strong></p>
      </div>
    <% } %>

    <div style="display: flex; gap: 14px; justify-content: center;">
      <a href="/user/orders" class="btn btn-primary">Theo dõi đơn hàng</a>
      <a href="/shop" class="btn btn-outline">Tiếp tục mua sắm</a>
    </div>

  </div>
</div>
