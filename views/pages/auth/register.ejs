<div style="margin-bottom: 24px;">
  <span style="font-size: 11px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: var(--color-primary); background: var(--color-primary-bg); padding: 4px 10px; border-radius: var(--radius-full); display: inline-block; margin-bottom: 10px;">
    GIA NHẬP CỘNG ĐỒNG
  </span>
  <h1 style="font-size: 26px; font-weight: 800; color: var(--color-text); letter-spacing: -0.5px; margin-bottom: 6px;">
    Đăng ký tài khoản
  </h1>
  <p style="font-size: 14px; color: var(--color-text-muted);">
    Bắt đầu trải nghiệm nông sản hữu cơ đạt chuẩn kiểm định
  </p>
</div>

<form action="/auth/register" method="POST">
  <div class="form-group">
    <label for="fullName" class="form-label">Họ và tên của bạn</label>
    <div class="input-wrapper">
      <span class="input-icon">👤</span>
      <input type="text" id="fullName" name="fullName" class="form-input" placeholder="Nguyễn Văn A" required>
    </div>
  </div>

  <div class="form-group">
    <label for="email" class="form-label">Địa chỉ Email</label>
    <div class="input-wrapper">
      <span class="input-icon">✉️</span>
      <input type="email" id="email" name="email" class="form-input" placeholder="tenban@gmail.com" required>
    </div>
  </div>

  <div class="form-group">
    <label for="password" class="form-label">Mật khẩu (tối thiểu 6 ký tự)</label>
    <div class="input-wrapper">
      <span class="input-icon">🔒</span>
      <input type="password" id="password" name="password" class="form-input" placeholder="••••••••" minlength="6" required>
    </div>
  </div>

  <div class="form-group" style="margin-bottom: 24px;">
    <label for="confirmPassword" class="form-label">Xác nhận lại mật khẩu</label>
    <div class="input-wrapper">
      <span class="input-icon">🛡️</span>
      <input type="password" id="confirmPassword" name="confirmPassword" class="form-input" placeholder="••••••••" minlength="6" required>
    </div>
  </div>

  <button type="submit" class="btn-submit">
    <span>Tạo tài khoản ngay</span>
    <span style="font-size: 17px;">→</span>
  </button>
</form>

<div class="auth-footer">
  Đã có tài khoản ORGO? 
  <a href="/auth/login" class="auth-link" style="font-weight: 700;">
    Đăng nhập tại đây
  </a>
</div>
