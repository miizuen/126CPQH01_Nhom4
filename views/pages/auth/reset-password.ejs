<div style="margin-bottom: 24px;">
  <span style="font-size: 11px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: var(--color-primary); background: var(--color-primary-bg); padding: 4px 10px; border-radius: var(--radius-full); display: inline-block; margin-bottom: 10px;">
    BẢO MẬT TÀI KHOẢN
  </span>
  <h1 style="font-size: 26px; font-weight: 800; color: var(--color-text); letter-spacing: -0.5px; margin-bottom: 6px;">
    Đặt lại mật khẩu
  </h1>
  <p style="font-size: 14px; color: var(--color-text-muted);">
    Vui lòng thiết lập mật khẩu mới có độ dài từ 6 ký tự trở lên
  </p>
</div>

<form action="/auth/reset-password" method="POST">
  <input type="hidden" name="token" value="<%= typeof token !== 'undefined' ? token : '' %>">
  
  <div class="form-group">
    <label for="password" class="form-label">Mật khẩu mới</label>
    <div class="input-wrapper">
      <span class="input-icon">🔒</span>
      <input type="password" id="password" name="password" class="form-input" placeholder="••••••••" minlength="6" required>
    </div>
  </div>

  <div class="form-group" style="margin-bottom: 24px;">
    <label for="confirmPassword" class="form-label">Xác nhận lại mật khẩu</label>
    <div class="input-wrapper">
      <span class="input-icon">🛡️</span>
      <input type="password" id="confirmPassword" name="confirmPassword" class="form-input" placeholder="••••••••" minlength="6" required>
    </div>
  </div>

  <button type="submit" class="btn-submit">
    <span>Cập nhật mật khẩu</span>
    <span style="font-size: 17px;">✓</span>
  </button>
</form>

<div class="auth-footer">
  <a href="/auth/login" class="auth-link">
    ← Quay lại trang đăng nhập
  </a>
</div>
