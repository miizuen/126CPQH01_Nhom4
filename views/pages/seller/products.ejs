<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; flex-wrap: wrap; gap: 16px;">
  <div>
    <div style="display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 1.5px; color: #107070; background: #e6f4f1; padding: 6px 14px; border-radius: 30px; margin-bottom: 8px;">
      <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #107070;"></span>
      KHO NÔNG SẢN TƯƠI SỐNG
    </div>
    <h1 style="font-family: 'Playfair Display', serif; font-size: 32px; font-weight: 700; color: #083838; margin: 0;">
      Danh Mục Nông Sản & Tồn Kho
    </h1>
    <p style="color: #64748b; font-size: 14.5px; margin: 6px 0 0 0;">
      Theo dõi số lượng thu hoạch, quản lý chứng nhận hữu cơ (VietGAP, USDA) và cập nhật giá bán
    </p>
  </div>
  <a href="/seller/products/new" style="background: linear-gradient(135deg, #107070 0%, #0d5454 100%); color: #fff; font-weight: 700; font-size: 14.5px; padding: 13px 26px; border-radius: 30px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 6px 20px rgba(16, 112, 112, 0.28); transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform=''">
    <span>🌿 + Thêm Nông Sản Mới</span>
  </a>
</div>

<div style="background: #FFFFFF; border-radius: 24px; padding: 32px; border: 1px solid #E2DFD7; box-shadow: 0 10px 30px rgba(16, 112, 112, 0.04);">
  <% if (typeof products !== 'undefined' && products.length) { %>
    <div style="overflow-x: auto;">
      <table style="width: 100%; border-collapse: separate; border-spacing: 0 8px; text-align: left;">
        <thead>
          <tr style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.8px; color: #64748b;">
            <th style="padding: 12px 16px;">Nông sản</th>
            <th style="padding: 12px 16px;">Giá niêm yết</th>
            <th style="padding: 12px 16px;">Tồn kho sẵn có</th>
            <th style="padding: 12px 16px;">Chứng nhận</th>
            <th style="padding: 12px 16px;">Trạng thái</th>
            <th style="padding: 12px 16px; text-align: right;">Hành động</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(p => { 
            let pImg = p.images && p.images[0] ? p.images[0] : (p.thumbnail || '');
            if (!pImg || pImg.includes('photo-1603099837564-6234c948b769')) {
              pImg = 'https://images.unsplash.com/photo-1576045057995-568f588f82fb?auto=format&fit=crop&w=120&q=80';
            }
          %>
            <tr style="background: #fafaf9; border-radius: 12px; transition: background 0.2s;" onmouseover="this.style.background='#f5f5f4'" onmouseout="this.style.background='#fafaf9'">
              <td style="padding: 16px; display: flex; align-items: center; gap: 14px; border-top-left-radius: 12px; border-bottom-left-radius: 12px;">
                <img src="<%= pImg %>" 
                     alt="<%= p.name %>"
                     style="width: 56px; height: 56px; border-radius: 14px; object-fit: cover; border: 1px solid #d6d3d1; flex-shrink: 0; box-shadow: 0 2px 6px rgba(0,0,0,0.06);">
                <div>
                  <a href="/products/<%= p.slug %>" target="_blank" style="font-size: 15px; font-weight: 700; color: #083838; text-decoration: none; display: block; margin-bottom: 4px; line-height: 1.3;" onmouseover="this.style.color='#107070'" onmouseout="this.style.color='#083838'">
                    <%= p.name %> ↗
                  </a>
                  <span style="font-size: 12px; color: #64748b;">Đơn vị tính: <b><%= p.unit || 'bó/hộp' %></b></span>
                </div>
              </td>
              <td style="padding: 16px; font-weight: 800; font-size: 16px; color: #107070;">
                <%= p.price ? p.price.toLocaleString('vi-VN') : 0 %> đ
              </td>
              <td style="padding: 16px;">
                <span style="font-weight: 700; color: <%= p.stock > 10 ? '#15803d' : '#b45309' %>; font-size: 14.5px;">
                  <%= p.stock %> <%= p.unit || 'phần' %>
                </span>
                <% if (p.stock <= 5) { %>
                  <span style="display: block; font-size: 11px; color: #dc2626; font-weight: 600;">Sắp hết hàng</span>
                <% } %>
              </td>
              <td style="padding: 16px;">
                <span style="display: inline-flex; align-items: center; gap: 5px; background: #e6f6f3; color: #107070; font-size: 12px; font-weight: 700; padding: 4px 12px; border-radius: 20px; border: 1px solid #bce4dc;">
                  🌱 <%= (p.certifications && p.certifications.length) ? p.certifications.join(', ') : 'VietGAP Hữu Cơ' %>
                </span>
              </td>
              <td style="padding: 16px;">
                <% if (p.status === 'ACTIVE') { %>
                  <span style="display: inline-flex; align-items: center; gap: 6px; background: #dcfce7; color: #166534; font-size: 12px; font-weight: 700; padding: 5px 12px; border-radius: 20px; border: 1px solid #bbf7d0;">
                    ● Đang mở bán
                  </span>
                <% } else { %>
                  <span style="display: inline-flex; align-items: center; gap: 6px; background: #fef3c7; color: #92400e; font-size: 12px; font-weight: 700; padding: 5px 12px; border-radius: 20px; border: 1px solid #fde68a;">
                    Tạm dừng
                  </span>
                <% } %>
              </td>
              <td style="padding: 16px; text-align: right; border-top-right-radius: 12px; border-bottom-right-radius: 12px;">
                <div style="display: inline-flex; gap: 8px;">
                  <a href="/seller/products/edit/<%= p._id %>" style="background: #FFFFFF; color: #083838; font-size: 13px; font-weight: 700; padding: 6px 14px; border-radius: 18px; text-decoration: none; border: 1px solid #d6d3d1; transition: all 0.2s;" onmouseover="this.style.borderColor='#107070'; this.style.color='#107070'" onmouseout="this.style.borderColor='#d6d3d1'; this.style.color='#083838'">
                    Sửa
                  </a>
                  <form action="/seller/products/delete/<%= p._id %>" method="POST" style="display: inline;" onsubmit="return confirm('Bạn có chắc muốn gỡ mặt hàng này không?')">
                    <button type="submit" style="background: #fff1f2; color: #e11d48; font-size: 13px; font-weight: 700; padding: 6px 14px; border-radius: 18px; border: 1px solid #fecdd3; cursor: pointer; transition: all 0.2s;" onmouseover="this.style.background='#ffe4e6'" onmouseout="this.style.background='#fff1f2'">
                      Gỡ
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div style="text-align: center; padding: 60px 20px; background: #fafaf9; border-radius: 16px; border: 1px dashed #d6d3d1;">
      <div style="font-size: 48px; margin-bottom: 12px;">🌱</div>
      <div style="font-size: 17px; font-weight: 700; color: #1e293b; margin-bottom: 6px;">Kho hàng nông sản đang trống</div>
      <p style="font-size: 14px; color: #64748b; max-width: 440px; margin: 0 auto 20px auto;">
        Hãy đăng tải các loại rau hữu cơ, củ quả, hoa quả sạch từ trang trại của bạn để tiếp cận khách hàng trên ORGO.
      </p>
      <a href="/seller/products/new" style="background: #107070; color: #fff; font-weight: 700; font-size: 14px; padding: 12px 28px; border-radius: 30px; text-decoration: none; display: inline-block;">
        + Thêm nông sản đầu tiên
      </a>
    </div>
  <% } %>
</div>
