<style>
  /* ─── MODERN NATURAL ORGANIC THEME (Warm Clay, Sage & Forest) ─── */
  :root {
    --org-forest: #14382c;
    --org-sage: #2d6a4f;
    --org-sand: #fbf9f5;
    --org-cream: #f4eee1;
    --org-clay: #d97706;
    --org-terracotta: #c2410c;
    --org-gold: #eab308;
    --org-border: #e8e2d5;
    --org-shadow: 0 10px 30px -5px rgba(20, 56, 44, 0.05), 0 4px 12px -2px rgba(20, 56, 44, 0.03);
    --org-shadow-hover: 0 20px 40px -10px rgba(20, 56, 44, 0.12), 0 8px 16px -4px rgba(20, 56, 44, 0.06);
  }

  .seller-dash-wrap {
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
    color: #1e293b;
  }

  /* Natural Ambient Hero Card */
  .dash-hero-banner {
    position: relative;
    background: linear-gradient(135deg, #123326 0%, #1a4735 60%, #245b44 100%);
    border-radius: 28px;
    padding: 40px 44px;
    color: #ffffff;
    margin-bottom: 36px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(18, 51, 38, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .dash-hero-banner::before {
    content: '';
    position: absolute;
    top: 0; right: 0; bottom: 0; left: 0;
    background-image: radial-gradient(circle at 85% 20%, rgba(134, 239, 172, 0.15) 0%, transparent 50%),
                      radial-gradient(circle at 95% 80%, rgba(234, 179, 8, 0.12) 0%, transparent 40%);
    pointer-events: none;
  }

  /* Metric cards with organic subtle styling */
  .metric-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 22px;
    margin-bottom: 36px;
  }
  .metric-card {
    background: #ffffff;
    border-radius: 22px;
    padding: 26px 28px;
    border: 1px solid var(--org-border);
    box-shadow: var(--org-shadow);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .metric-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--org-shadow-hover);
    border-color: #cbd5e1;
  }
  .metric-label {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #64748b;
    margin-bottom: 8px;
  }
  .metric-value {
    font-family: 'Playfair Display', serif;
    font-size: 34px;
    font-weight: 700;
    color: var(--org-forest);
    line-height: 1.1;
    margin-bottom: 12px;
  }
  .metric-icon-box {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    flex-shrink: 0;
  }

  /* Clean Data Table */
  .dash-table-wrap {
    background: #ffffff;
    border-radius: 24px;
    border: 1px solid var(--org-border);
    box-shadow: var(--org-shadow);
    padding: 32px 36px;
  }
  .dash-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 10px;
  }
  .dash-table th {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #64748b;
    padding: 10px 16px;
    border-bottom: 1px solid var(--org-border);
  }
  .dash-table td {
    padding: 16px;
    background: #fbfbf9;
    font-size: 14px;
    transition: background 0.2s;
  }
  .dash-table tr:hover td {
    background: #f4f3ed;
  }
  .dash-table td:first-child {
    border-top-left-radius: 14px;
    border-bottom-left-radius: 14px;
  }
  .dash-table td:last-child {
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
  }
</style>

<div class="seller-dash-wrap">

  <!-- ─── 1. NATURAL AMBIENT HERO BANNER ───────────────────────────────── -->
  <div class="dash-hero-banner">
    <div style="position: relative; z-index: 2; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 24px;">
      <div>
        <div style="display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: #86efac; background: rgba(134, 239, 172, 0.15); padding: 5px 14px; border-radius: 30px; margin-bottom: 14px; border: 1px solid rgba(134, 239, 172, 0.3);">
          <span>🌱</span> KÊNH NÔNG TRẠI HỮU CƠ TRỰC TIẾP
        </div>
        <h1 style="font-family: 'Playfair Display', serif; font-size: 34px; font-weight: 700; margin: 0 0 8px 0; color: #ffffff; line-height: 1.2;">
          Bảng Điều Hành Nông Trại
        </h1>
        <p style="margin: 0; color: #cbd5e1; font-size: 15px; max-width: 540px; line-height: 1.5;">
          Theo dõi chuỗi cung ứng nông sản sạch từ vườn đến giỏ hàng người tiêu dùng, quản lý sản lượng và doanh thu minh bạch.
        </p>
      </div>

      <div style="display: flex; gap: 14px; align-items: center;">
        <a href="/seller/products/new" style="background: #ffffff; color: var(--org-forest); font-weight: 700; font-size: 14.5px; padding: 13px 26px; border-radius: 30px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 8px 20px rgba(0,0,0,0.2); transition: all 0.25s;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 12px 25px rgba(0,0,0,0.25)';" onmouseout="this.style.transform=''; this.style.boxShadow='0 8px 20px rgba(0,0,0,0.2)';">
          <span>+ Đăng Nông Sản Mới</span>
        </a>
        <a href="/seller/wallet" style="background: rgba(255,255,255,0.12); backdrop-filter: blur(10px); color: #ffffff; font-weight: 600; font-size: 14px; padding: 13px 22px; border-radius: 30px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; border: 1px solid rgba(255,255,255,0.25); transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.2)'" onmouseout="this.style.background='rgba(255,255,255,0.12)'">
          <span>Ví Tài Khoản →</span>
        </a>
      </div>
    </div>
  </div>

  <!-- ─── 2. REFINED METRICS GRID ──────────────────────────────────────── -->
  <div class="metric-grid">
    
    <!-- Metric 1: Nông sản niêm yết -->
    <div class="metric-card">
      <div style="display: flex; justify-content: space-between; align-items: flex-start;">
        <div>
          <div class="metric-label">Nông sản niêm yết</div>
          <div class="metric-value"><%= typeof totalProducts !== 'undefined' ? totalProducts : 0 %></div>
        </div>
        <div class="metric-icon-box" style="background: #ecfdf5; color: #059669; border: 1px solid #a7f3d0;">
          🥦
        </div>
      </div>
      <div style="display: flex; justify-content: space-between; align-items: center; font-size: 12.5px; border-top: 1px solid #f1f5f9; padding-top: 12px;">
        <span style="color: #059669; font-weight: 700;">● Đang phân phối sỉ & lẻ</span>
        <a href="/seller/products" style="color: #64748b; font-weight: 600; text-decoration: none;">Kho hàng →</a>
      </div>
    </div>

    <!-- Metric 2: Đơn chờ chuẩn bị -->
    <div class="metric-card">
      <div style="display: flex; justify-content: space-between; align-items: flex-start;">
        <div>
          <div class="metric-label">Đơn chờ đóng gói</div>
          <div class="metric-value" style="color: var(--org-terracotta);">
            <%= typeof pendingOrders !== 'undefined' ? pendingOrders : 0 %>
          </div>
        </div>
        <div class="metric-icon-box" style="background: #fff7ed; color: #c2410c; border: 1px solid #fed7aa;">
          📦
        </div>
      </div>
      <div style="display: flex; justify-content: space-between; align-items: center; font-size: 12.5px; border-top: 1px solid #f1f5f9; padding-top: 12px;">
        <span style="color: var(--org-terracotta); font-weight: 700;">⚡ Cần chuẩn bị xe lạnh</span>
        <a href="/seller/orders" style="color: #64748b; font-weight: 600; text-decoration: none;">Xem đơn →</a>
      </div>
    </div>

    <!-- Metric 3: Số dư khả dụng -->
    <div class="metric-card">
      <div style="display: flex; justify-content: space-between; align-items: flex-start;">
        <div>
          <div class="metric-label">Số dư khả dụng</div>
          <div class="metric-value" style="color: var(--org-sage);">
            <%= ((wallet && wallet.balance) || 0).toLocaleString('vi-VN') %><span style="font-size: 18px; font-weight: 600; margin-left: 2px;">đ</span>
          </div>
        </div>
        <div class="metric-icon-box" style="background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0;">
          💰
        </div>
      </div>
      <div style="display: flex; justify-content: space-between; align-items: center; font-size: 12.5px; border-top: 1px solid #f1f5f9; padding-top: 12px;">
        <span style="color: #166534; font-weight: 700;">✓ Sẵn sàng giải ngân</span>
        <a href="/seller/wallet" style="color: var(--org-sage); font-weight: 700; text-decoration: none;">Rút về ATM →</a>
      </div>
    </div>

    <!-- Metric 4: Tiền đang xử lý -->
    <div class="metric-card">
      <div style="display: flex; justify-content: space-between; align-items: flex-start;">
        <div>
          <div class="metric-label">Tạm giữ đối soát</div>
          <div class="metric-value" style="color: #475569;">
            <%= ((wallet && wallet.lockedAmount) || 0).toLocaleString('vi-VN') %><span style="font-size: 18px; font-weight: 600; margin-left: 2px;">đ</span>
          </div>
        </div>
        <div class="metric-icon-box" style="background: #f8fafc; color: #64748b; border: 1px solid #e2e8f0;">
          🔒
        </div>
      </div>
      <div style="display: flex; justify-content: space-between; align-items: center; font-size: 12.5px; border-top: 1px solid #f1f5f9; padding-top: 12px;">
        <span style="color: #64748b; font-weight: 600;">Chu kỳ 24h - 48h</span>
        <span style="color: #94a3b8;">Bảo lãnh an tâm</span>
      </div>
    </div>

  </div>

  <!-- ─── 3. RECENT ORDERS ORGANIC TABLE ────────────────────────────────── -->
  <div class="dash-table-wrap">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 22px; flex-wrap: wrap; gap: 12px;">
      <div>
        <h3 style="font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 700; color: var(--org-forest); margin: 0;">
          Đơn Mua Nông Sản Mới Nhất
        </h3>
        <p style="font-size: 13.5px; color: #64748b; margin: 4px 0 0 0;">
          Danh sách khách hàng đặt mua rau củ quả tươi từ nhà vườn của bạn
        </p>
      </div>
      <a href="/seller/orders" style="display: inline-flex; align-items: center; gap: 6px; background: #fbf9f5; color: var(--org-forest); font-weight: 700; font-size: 13.5px; padding: 8px 18px; border-radius: 20px; text-decoration: none; border: 1px solid var(--org-border); transition: all 0.2s;" onmouseover="this.style.borderColor='var(--org-sage)'; this.style.color='var(--org-sage)'" onmouseout="this.style.borderColor='var(--org-border)'; this.style.color='var(--org-forest)'">
        <span>Xem tất cả đơn hàng</span>
        <span>→</span>
      </a>
    </div>

    <% if (typeof recentOrders !== 'undefined' && recentOrders.length) { %>
      <div style="overflow-x: auto;">
        <table class="dash-table">
          <thead>
            <tr>
              <th>Mã Đơn</th>
              <th>Thời Gian</th>
              <th>Tổng Giá Trị</th>
              <th>Tiến Độ Giao Hàng</th>
              <th style="text-align: right;">Hành Động</th>
            </tr>
          </thead>
          <tbody>
            <% recentOrders.forEach(o => { %>
              <tr>
                <td style="font-weight: 700; color: var(--org-forest);">
                  <span style="font-family: monospace; background: #eef5f2; color: var(--org-sage); padding: 4px 10px; border-radius: 8px; font-size: 13px;">
                    #<%= o._id.toString().slice(-8).toUpperCase() %>
                  </span>
                </td>
                <td style="color: #475569; font-size: 13.5px;">
                  <%= new Date(o.createdAt).toLocaleString('vi-VN', { dateStyle: 'short', timeStyle: 'short' }) %>
                </td>
                <td style="font-weight: 800; color: var(--org-forest); font-size: 15.5px;">
                  <%= o.total ? o.total.toLocaleString('vi-VN') : 0 %> đ
                </td>
                <td>
                  <% if (o.status === 'DELIVERED') { %>
                    <span style="display: inline-flex; align-items: center; gap: 6px; background: #dcfce7; color: #166534; font-size: 12px; font-weight: 700; padding: 5px 12px; border-radius: 20px; border: 1px solid #bbf7d0;">
                      ✓ Đã nhận hàng an toàn
                    </span>
                  <% } else if (o.status === 'SHIPPING') { %>
                    <span style="display: inline-flex; align-items: center; gap: 6px; background: #e0f2fe; color: #0369a1; font-size: 12px; font-weight: 700; padding: 5px 12px; border-radius: 20px; border: 1px solid #bae6fd;">
                      🚚 Xe lạnh đang giao
                    </span>
                  <% } else if (o.status === 'CONFIRMED') { %>
                    <span style="display: inline-flex; align-items: center; gap: 6px; background: #fef3c7; color: #92400e; font-size: 12px; font-weight: 700; padding: 5px 12px; border-radius: 20px; border: 1px solid #fde68a;">
                      📦 Đang đóng gói tươi
                    </span>
                  <% } else { %>
                    <span style="display: inline-flex; align-items: center; gap: 6px; background: #f1f5f9; color: #475569; font-size: 12px; font-weight: 700; padding: 5px 12px; border-radius: 20px;">
                      Chờ xác nhận
                    </span>
                  <% } %>
                </td>
                <td style="text-align: right;">
                  <a href="/seller/orders" style="background: #ffffff; color: var(--org-forest); font-size: 13px; font-weight: 700; padding: 7px 16px; border-radius: 20px; text-decoration: none; border: 1px solid #cbd5e1; transition: all 0.2s;" onmouseover="this.style.borderColor='var(--org-sage)'; this.style.color='var(--org-sage)'" onmouseout="this.style.borderColor='#cbd5e1'; this.style.color='var(--org-forest)'">
                    Chi tiết
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div style="text-align: center; padding: 50px 20px; background: #fbf9f5; border-radius: 18px; border: 1px dashed var(--org-border);">
        <div style="font-size: 42px; margin-bottom: 10px;">🧺</div>
        <div style="font-size: 16px; font-weight: 700; color: #1e293b; margin-bottom: 4px;">Chưa có đơn hàng nào</div>
        <div style="font-size: 13.5px; color: #64748b;">Khi khách đặt mua nông sản từ vườn của bạn, thông tin sẽ được đẩy về đây tức thì.</div>
      </div>
    <% } %>
  </div>

</div>
