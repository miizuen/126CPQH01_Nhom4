<div class="container" style="padding: 40px 20px;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <h1 style="font-size: 24px; font-weight: 800; color: var(--dark);">Quản Lý Đơn Hàng Toàn Sàn</h1>
    <a href="/admin" class="btn btn-outline btn-sm">← Quay lại Dashboard</a>
  </div>

  <div style="background: var(--white); border-radius: var(--radius-md); padding: 24px; border: 1px solid var(--gray-200);">
    <table style="width: 100%; border-collapse: collapse;">
      <thead>
        <tr style="text-align: left; font-size: 13px; color: var(--gray-500); border-bottom: 1.5px solid var(--gray-200);">
          <th style="padding-bottom: 10px;">Mã đơn</th>
          <th style="padding-bottom: 10px;">Khách hàng</th>
          <th style="padding-bottom: 10px;">Ngày đặt</th>
          <th style="padding-bottom: 10px;">PTTT</th>
          <th style="padding-bottom: 10px;">Tổng tiền</th>
          <th style="padding-bottom: 10px;">Trạng thái</th>
        </tr>
      </thead>
      <tbody>
        <% orders.forEach(o => { %>
          <tr style="border-bottom: 1px solid var(--gray-200);">
            <td style="padding: 14px 0;"><strong>#<%= o._id.toString().slice(-8).toUpperCase() %></strong></td>
            <td style="padding: 14px 0;"><%= o.user ? o.user.fullName : 'N/A' %></td>
            <td style="padding: 14px 0; font-size: 13px; color: var(--gray-500);"><%= new Date(o.createdAt).toLocaleDateString('vi-VN') %></td>
            <td style="padding: 14px 0; font-size: 13px;"><%= o.paymentMethod %></td>
            <td style="padding: 14px 0; font-weight: 700; color: var(--primary-dark);"><%= o.total ? o.total.toLocaleString('vi-VN') : 0 %>đ</td>
            <td style="padding: 14px 0;">
              <span style="background: var(--primary-light); color: var(--primary-dark); font-size: 12px; font-weight: 700; padding: 2px 10px; border-radius: var(--radius-full);"><%= o.status %></span>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
