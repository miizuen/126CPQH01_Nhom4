<div class="container" style="padding: 40px 20px;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <h1 style="font-size: 24px; font-weight: 800; color: var(--dark);">Quản Lý Người Dùng & Phân Quyền</h1>
    <a href="/admin" class="btn btn-outline btn-sm">← Quay lại Dashboard</a>
  </div>

  <div style="background: var(--white); border-radius: var(--radius-md); padding: 24px; border: 1px solid var(--gray-200);">
    <table style="width: 100%; border-collapse: collapse;">
      <thead>
        <tr style="text-align: left; font-size: 13px; color: var(--gray-500); border-bottom: 1.5px solid var(--gray-200);">
          <th style="padding-bottom: 10px;">Họ tên</th>
          <th style="padding-bottom: 10px;">Email</th>
          <th style="padding-bottom: 10px;">Vai trò hiện tại</th>
          <th style="padding-bottom: 10px;">Phân quyền</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(u => { %>
          <tr style="border-bottom: 1px solid var(--gray-200);">
            <td style="padding: 14px 0;"><strong><%= u.fullName %></strong></td>
            <td style="padding: 14px 0; color: var(--gray-500);"><%= u.email %></td>
            <td style="padding: 14px 0;">
              <span style="background: var(--primary-light); color: var(--primary-dark); font-size: 12px; font-weight: 700; padding: 2px 10px; border-radius: var(--radius-full);"><%= u.role %></span>
            </td>
            <td style="padding: 14px 0;">
              <form action="/admin/users/<%= u._id %>/role" method="POST" style="display: flex; gap: 8px; margin: 0;">
                <select name="role" style="padding: 6px 10px; border: 1px solid var(--gray-200); border-radius: var(--radius-sm); font-size: 13px;">
                  <option value="CUSTOMER" <%= u.role === 'CUSTOMER' ? 'selected' : '' %>>CUSTOMER</option>
                  <option value="SELLER" <%= u.role === 'SELLER' ? 'selected' : '' %>>SELLER</option>
                  <option value="EXPERT" <%= u.role === 'EXPERT' ? 'selected' : '' %>>EXPERT</option>
                  <option value="ADMIN" <%= u.role === 'ADMIN' ? 'selected' : '' %>>ADMIN</option>
                </select>
                <button type="submit" class="btn btn-outline btn-sm">Cập nhật</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
