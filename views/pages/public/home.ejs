<!-- ─── 6. 4 LÝ DO CHỌN ORGO (REASONS / COMMITMENTS) ───────────────────────── -->
<section style="background: #FFFFFF; padding: 70px 0; border-top: 1px solid var(--lf-border); border-bottom: 1px solid var(--lf-border);">
  <div class="container">
    
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 40px; flex-wrap: wrap; gap: 20px;">
      <div>
        <div style="font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 1.5px; color: #256b40; margin-bottom: 6px;">
          CAM KẾT MINH BẠCH
        </div>
        <h2 style="font-family: 'Lora', Georgia, serif; font-size: 34px; font-weight: 700; color: #16301f; margin: 0;">
          Sạch từ gốc, rõ từng lô hàng.
        </h2>
      </div>
      <p style="color: #64748b; font-size: 15px; max-width: 500px; margin: 0; line-height: 1.6;">
        Mỗi túi rau củ quả đến bàn ăn của bạn đều có thể kiểm chứng nguồn gốc đất trồng, phân bón và ngày cắt tỉa.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 24px;">
      
      <div class="lf-reason-box">
        <span class="lf-reason-num">01</span>
        <div class="lf-reason-title">Truy xuất từng lô hàng</div>
        <div class="lf-reason-desc">Quét mã QR trên tem bao bì để xem camera trực tiếp tại nông trại, nhật ký chăm sóc và kết quả kiểm nghiệm.</div>
      </div>

      <div class="lf-reason-box">
        <span class="lf-reason-num">02</span>
        <div class="lf-reason-title">Kiểm định trước đóng gói</div>
