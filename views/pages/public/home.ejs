<!-- ─── 1. HERO BANNER LOFI ORGANIC (ĐI CHỢ SẠCH NGAY TẠI NHÀ) ─────────────── -->
<section class="lf-hero-wrap">
  <img 
    src="https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=1600&q=85" 
    alt="Đi chợ nông sản sạch ORGO" 
    class="lf-hero-bg"
  >
  <div class="lf-hero-overlay"></div>
  <div class="container lf-hero-content">
    <div class="badge-pill bg-green" style="margin-bottom: 20px; background: rgba(34, 197, 94, 0.2); color: #86efac; border: 1px solid rgba(134, 239, 172, 0.4);">
      🌱 Siêu thị nông sản sạch & hữu cơ
    </div>
    <h1 class="lf-hero-title">
      Đi chợ sạch<br><em>ngay tại nhà.</em>
    </h1>
    <p class="lf-hero-lead">
      Rau củ, trái cây, thịt cá, trứng sữa và thảo mộc nhập trực tiếp từ các nông trại hữu cơ đạt chuẩn VietGAP & USDA. Đặt trước 16:00, nhận hàng trong ngày với chuỗi xe lạnh an toàn.
    </p>
    <div style="display: flex; gap: 16px; align-items: center; flex-wrap: wrap;">
      <a href="/shop" class="btn" style="background: #FFFFFF; color: #16301f; font-weight: 700; font-size: 15.5px; padding: 14px 32px; border-radius: 30px; text-decoration: none; box-shadow: 0 4px 20px rgba(0,0,0,0.25); display: inline-flex; align-items: center; gap: 8px;">
        <span>Mua sắm ngay</span>
        <span>→</span>
      </a>
      <a href="#flash-sale" class="btn" style="background: rgba(255, 255, 255, 0.15); backdrop-filter: blur(10px); color: #FFFFFF; font-weight: 600; font-size: 15px; padding: 14px 28px; border-radius: 30px; text-decoration: none; border: 1px solid rgba(255, 255, 255, 0.35);">
        🔥 Xem ưu đãi tuần này
      </a>
    </div>
  </div>
</section>

<!-- ─── 2. FLASH SALE / ƯU ĐÃI CUỐI TUẦN (COUNTDOWN TIMER) ────────────────── -->
<section id="flash-sale" style="background: #FFFFFF; border-bottom: 1px solid var(--lf-border); padding: 50px 0 60px 0;">
  <div class="container">
    
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 32px; flex-wrap: wrap; gap: 20px;">
      <div>
        <div class="badge-pill bg-orange" style="margin-bottom: 8px;">
          ⚡ Ưu đãi cuối tuần
        </div>
        <h2 style="font-family: 'Lora', Georgia, serif; font-size: 32px; font-weight: 700; color: #16301f; margin: 0;">
          Giá tốt đến hết Chủ nhật
        </h2>
      </div>

      <!-- Đồng hồ đếm ngược -->
      <div class="lf-countdown-wrapper">
        <span style="font-size: 13.5px; font-weight: 700; color: #16301f;">Kết thúc sau:</span>
        <div class="lf-countdown-box">
          <b id="cdDays">02</b>
          <small>Ngày</small>
        </div>
        <div class="lf-countdown-box">
          <b id="cdHours">14</b>
          <small>Giờ</small>
        </div>
        <div class="lf-countdown-box">
          <b id="cdMins">35</b>
          <small>Phút</small>
        </div>
        <div class="lf-countdown-box">
          <b id="cdSecs">20</b>
          <small>Giây</small>
        </div>
      </div>
    </div>

    <!-- Grid sản phẩm ưu đãi Flash Sale -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px;">
      <% 
        const deals = (typeof featuredProducts !== 'undefined' && featuredProducts.length) ? featuredProducts.slice(0, 4) : [];
        if (deals.length) {
          deals.forEach((p, idx) => {
            const discountPercent = [25, 20, 18, 30][idx % 4];
            const originalPrice = p.comparePrice || Math.round(p.price * 1.25);
      %>
        <div class="lf-deal-card">
          <div class="lf-deal-media">
            <% 
              let dealImg = (p.images && p.images[0]) || p.thumbnail || '';
              if (!dealImg || dealImg.includes('1576045057995') || dealImg.includes('1603099837564') || (p.slug && p.slug.includes('kale'))) {
                dealImg = '/images/cai-kale.jpg';
              }
            %>
            <img src="<%= dealImg %>" alt="<%= p.name %>" loading="lazy" onerror="this.onerror=null; this.src='/images/cai-kale.jpg';">
            <span class="lf-deal-badge">−<%= discountPercent %>%</span>
          </div>
          <div class="lf-deal-body">
            <span class="lf-deal-farm">🌿 <%= (p.seller && p.seller.shopName) ? p.seller.shopName : 'BioFarm Đà Lạt' %></span>
            <a href="/products/<%= p.slug %>" class="lf-deal-name" title="<%= p.name %>">
              <%= p.name %>
            </a>
            <div class="lf-deal-prices">
              <span class="lf-deal-now"><%= p.price ? p.price.toLocaleString('vi-VN') : 0 %>đ</span>
              <span class="lf-deal-old"><%= originalPrice.toLocaleString('vi-VN') %>đ</span>
            </div>
            
            <div class="lf-stock-bar">
              <div class="lf-stock-progress" style="width: <%= [75, 60, 85, 45][idx % 4] %>%;"></div>
            </div>
            <div class="lf-stock-text">
              <span>Đã bán <%= [42, 68, 115, 30][idx % 4] %> suất</span>
              <span style="color: #c2410c; font-weight: 700;">Số lượng có hạn</span>
            </div>

            <button class="btn-lf-cart" onclick="quickAddToCart('<%= p._id %>')">
              🛒 Thêm vào giỏ hàng
            </button>
          </div>
        </div>
      <%   }); 
        } else { 
      %>
        <p style="grid-column: 1 / -1; text-align: center; color: #64748b; padding: 40px 0;">Đang cập nhật các deal nông sản hữu cơ mới nhất...</p>
      <% } %>
    </div>

  </div>
</section>

<!-- ─── 3. HAI BANNER ĐÔI (DUAL STORY BANNERS) ────────────────────────────── -->
<section style="padding: 50px 0;">
  <div class="container">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px;">
      
      <!-- Banner 1: Nông sản tươi mỗi sáng (Dark) -->
      <a href="/shop" style="position: relative; border-radius: 22px; overflow: hidden; min-height: 260px; display: flex; align-items: flex-end; padding: 32px; text-decoration: none; color: #fff; box-shadow: 0 10px 25px rgba(0,0,0,0.12);">
        <img src="https://images.unsplash.com/photo-1610348725531-843dff563e2c?auto=format&fit=crop&w=800&q=80" 
             style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease;"
             onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'" />
        <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(22, 48, 31, 0.2) 0%, rgba(22, 48, 31, 0.88) 100%);"></div>
        <div style="position: relative; z-index: 2;">
          <span class="badge-pill bg-orange" style="margin-bottom: 8px;">Tươi mỗi sáng</span>
          <h3 style="font-family: 'Lora', Georgia, serif; font-size: 24px; font-weight: 700; color: #fff; margin: 4px 0 6px 0;">
            Rau Củ & Nông Sản Về Kho Mỗi Sáng
          </h3>
          <p style="font-size: 14px; color: #e2e8f0; margin-bottom: 12px;">Thu hoạch từ các nhà vườn Đà Lạt & Mộc Châu lúc 4:00 sáng</p>
          <span style="font-weight: 700; font-size: 14px; color: #86efac;">Khám phá rau củ →</span>
        </div>
      </a>

      <!-- Banner 2: Trái cây nhập khẩu & bản địa (Light/Green) -->
      <a href="/shop" style="position: relative; border-radius: 22px; overflow: hidden; min-height: 260px; display: flex; align-items: flex-end; padding: 32px; text-decoration: none; color: #fff; box-shadow: 0 10px 25px rgba(0,0,0,0.12);">
        <img src="https://images.unsplash.com/photo-1619566636858-adf3ef46400b?auto=format&fit=crop&w=800&q=80" 
             style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease;"
             onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'" />
        <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(8, 56, 56, 0.2) 0%, rgba(8, 56, 56, 0.88) 100%);"></div>
        <div style="position: relative; z-index: 2;">
          <span class="badge-pill bg-green" style="margin-bottom: 8px;">Hàng mới về</span>
          <h3 style="font-family: 'Lora', Georgia, serif; font-size: 24px; font-weight: 700; color: #fff; margin: 4px 0 6px 0;">
            Trái Cây Hữu Cơ Mùa Thu Hoạch
          </h3>
          <p style="font-size: 14px; color: #e2e8f0; margin-bottom: 12px;">Dâu tây Hana, Bơ 034, Cam sành mọng nước chuẩn VietGAP</p>
          <span style="font-weight: 700; font-size: 14px; color: #fde047;">Xem danh mục trái cây →</span>
        </div>
      </a>

    </div>
  </div>
</section>

<!-- ─── 4. MUA THEO DANH MỤC (PILL TABS & PRODUCT SHOWCASE) ───────────────── -->
<section style="padding: 40px 0 60px 0;">
  <div class="container">
    
    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 24px; flex-wrap: wrap; gap: 14px;">
      <div>
        <div style="font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 1.5px; color: #256b40; margin-bottom: 4px;">
          DANH MỤC TUYỂN CHỌN
        </div>
        <h2 style="font-family: 'Lora', Georgia, serif; font-size: 30px; font-weight: 700; color: #16301f; margin: 0;">
          Mua Theo Nhóm Nông Sản
        </h2>
      </div>
      <a href="/shop" style="color: #256b40; font-weight: 700; font-size: 14px; text-decoration: none;">
        Xem toàn bộ cửa hàng →
      </a>
    </div>

    <!-- Category Pill Buttons -->
    <div style="display: flex; gap: 10px; margin-bottom: 30px; overflow-x: auto; padding-bottom: 8px;">
      <button class="cat-pill-btn active" onclick="filterCategory('all', this)" style="background: #16301f; color: #fff; border: none; padding: 10px 22px; border-radius: 30px; font-weight: 700; font-size: 14px; cursor: pointer; white-space: nowrap; transition: all 0.2s;">
        🌿 Tất cả nông sản
      </button>
      <% if (typeof categories !== 'undefined' && categories.length) { %>
        <% categories.forEach(c => { %>
          <button class="cat-pill-btn" onclick="filterCategory('<%= c._id %>', this)" style="background: #FFFFFF; color: #334155; border: 1.5px solid var(--lf-border); padding: 10px 20px; border-radius: 30px; font-weight: 600; font-size: 14px; cursor: pointer; white-space: nowrap; transition: all 0.2s;">
            <%= c.icon || '🥬' %> <%= c.name %>
          </button>
        <% }) %>
      <% } else { %>
        <button class="cat-pill-btn" style="background: #FFFFFF; color: #334155; border: 1.5px solid var(--lf-border); padding: 10px 20px; border-radius: 30px; font-weight: 600; font-size: 14px; white-space: nowrap;">🥬 Rau lá & Củ quả</button>
        <button class="cat-pill-btn" style="background: #FFFFFF; color: #334155; border: 1.5px solid var(--lf-border); padding: 10px 20px; border-radius: 30px; font-weight: 600; font-size: 14px; white-space: nowrap;">🍎 Trái cây miệt vườn</button>
        <button class="cat-pill-btn" style="background: #FFFFFF; color: #334155; border: 1.5px solid var(--lf-border); padding: 10px 20px; border-radius: 30px; font-weight: 600; font-size: 14px; white-space: nowrap;">🍵 Thảo mộc & Trà khô</button>
      <% } %>
    </div>

    <!-- Product Grid -->
    <div id="homeProductGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 24px;">
      <% 
        const allProds = (typeof newArrivals !== 'undefined' && newArrivals.length) ? newArrivals : featuredProducts;
        if (allProds && allProds.length) {
          allProds.forEach(p => { 
      %>
        <div class="product-item" data-category="<%= p.category ? p.category.toString() : '' %>" style="background: #FFFFFF; border-radius: 18px; border: 1px solid var(--lf-border); overflow: hidden; display: flex; flex-direction: column; transition: all 0.3s; position: relative;">
          
          <a href="/products/<%= p.slug %>" style="display: block; aspect-ratio: 1/1; overflow: hidden; background: #f8fafc; position: relative;">
            <% 
              let gridImg = (p.images && p.images[0]) || p.thumbnail || '';
              if (!gridImg || gridImg.includes('1576045057995') || gridImg.includes('1603099837564') || (p.slug && p.slug.includes('kale'))) {
                gridImg = '/images/cai-kale.jpg';
              }
            %>
            <img src="<%= gridImg %>" alt="<%= p.name %>" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s;" onmouseover="this.style.transform='scale(1.07)'" onmouseout="this.style.transform='scale(1)'" onerror="this.onerror=null; this.src='/images/cai-kale.jpg';" />
            <span style="position: absolute; top: 10px; left: 10px; background: rgba(255,255,255,0.92); color: #166534; font-size: 11px; font-weight: 800; padding: 3px 8px; border-radius: 20px; border: 1px solid #bbf7d0;">
              ✓ VietGAP
            </span>
          </a>

          <div style="padding: 16px; display: flex; flex-direction: column; flex-grow: 1;">
            <div style="font-size: 11.5px; color: #256b40; font-weight: 700; margin-bottom: 4px;">
              <%= (p.seller && p.seller.shopName) ? p.seller.shopName : 'Nông Trại Hữu Cơ' %>
            </div>
            <a href="/products/<%= p.slug %>" style="font-size: 15px; font-weight: 700; color: #0f172a; text-decoration: none; margin-bottom: 8px; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
              <%= p.name %>
            </a>
            
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: auto; padding-top: 12px; border-top: 1px solid #f1f5f9;">
              <div>
                <span style="font-size: 17px; font-weight: 800; color: #16301f;">
                  <%= p.price ? p.price.toLocaleString('vi-VN') : 0 %>đ
                </span>
                <span style="font-size: 12px; color: #64748b;">/<%= p.unit || 'gói' %></span>
              </div>
              <button onclick="quickAddToCart('<%= p._id %>')" title="Thêm vào giỏ" 
                      style="width: 36px; height: 36px; border-radius: 50%; background: #f0fdf4; border: 1.5px solid #86efac; color: #166534; font-size: 18px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s;"
                      onmouseover="this.style.background='#256b40'; this.style.color='#fff';"
                      onmouseout="this.style.background='#f0fdf4'; this.style.color='#166534';">
                +
              </button>
            </div>
          </div>

        </div>
      <%   });
        } 
      %>
    </div>

  </div>
</section>

<!-- ─── 5. GÓI GIỎ RAU ĐỊNH KỲ (LOFI ORGANIC SUBSCRIPTION BOXES) ───────────── -->
