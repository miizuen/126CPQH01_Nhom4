<!-- ─── TRANG CẨM NANG BLOG – LOFI ORGANIC STYLE ─────────────────────── -->

<!-- Page Header Banner -->
<section style="background: linear-gradient(135deg, #16301f 0%, #1e4028 100%); padding: 50px 0 56px; border-radius: 0 0 28px 28px; margin-bottom: 40px; text-align: center;">
  <div class="container" style="max-width: 760px;">
    <span class="badge-pill bg-green" style="background: rgba(34, 197, 94, 0.2); color: #86efac; border: 1px solid rgba(134, 239, 172, 0.4); margin-bottom: 16px;">
      📖 Cẩm nang kiến thức
    </span>
    <h1 style="font-family: 'Lora', Georgia, serif; font-size: 42px; font-weight: 700; color: #FFFFFF; margin: 0 0 14px 0; line-height: 1.2;">
      Góc Bếp Hữu Cơ &<br><em style="font-style: italic; font-weight: 400; color: #bbf7d0;">Sống Xanh Mỗi Ngày</em>
    </h1>
    <p style="color: #94a3b8; font-size: 15.5px; line-height: 1.65; max-width: 560px; margin: 0 auto;">
      Chia sẻ kinh nghiệm canh tác sạch, chọn lựa thực phẩm an toàn và công thức nấu ăn lành mạnh từ các chuyên gia dinh dưỡng hàng đầu.
    </p>
  </div>
</section>

<div class="container" style="padding-bottom: 80px;">

  <% if (typeof articles !== 'undefined' && articles.length) { %>

    <!-- Featured article (first one) -->
    <% const featuredArt = articles[0]; %>
    <div style="display: grid; grid-template-columns: 1.4fr 1fr; gap: 28px; margin-bottom: 48px;">
      
      <!-- Main featured article -->
      <article style="background: #FFFFFF; border-radius: 22px; overflow: hidden; border: 1px solid var(--lf-border); display: flex; flex-direction: column; box-shadow: 0 4px 16px rgba(22, 48, 31, 0.05);">
        <a href="/blog/<%= featuredArt.slug %>" style="display: block; aspect-ratio: 16/10; overflow: hidden;">
          <img src="<%= featuredArt.thumbnail || 'https://images.unsplash.com/photo-1592417817098-8f3d69109853?auto=format&fit=crop&w=900&q=80' %>" 
               alt="<%= featuredArt.title %>" 
               style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s;"
               onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
        </a>
        <div style="padding: 28px; display: flex; flex-direction: column; flex-grow: 1;">
          <span class="badge-pill bg-orange" style="margin-bottom: 12px; align-self: flex-start;">
            ★ Nổi bật
          </span>
          <span style="font-size: 12px; color: #256b40; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 8px;">
            <%= featuredArt.category ? featuredArt.category.name : 'Nông nghiệp sạch' %> • <%= new Date(featuredArt.createdAt).toLocaleDateString('vi-VN') %>
          </span>
          <a href="/blog/<%= featuredArt.slug %>" style="font-family: 'Lora', Georgia, serif; font-size: 24px; font-weight: 700; color: #16301f; text-decoration: none; margin-bottom: 12px; line-height: 1.35;">
            <%= featuredArt.title %>
          </a>
          <p style="color: #64748b; font-size: 14.5px; line-height: 1.65; margin-bottom: 20px; flex: 1; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
            <%= featuredArt.excerpt || (featuredArt.content ? featuredArt.content.replace(/<[^>]*>?/gm, '').slice(0, 160) + '...' : '') %>
          </p>
          <a href="/blog/<%= featuredArt.slug %>" style="font-weight: 700; font-size: 14px; color: #256b40; text-decoration: none; display: flex; align-items: center; gap: 6px; margin-top: auto;">
            Đọc bài viết đầy đủ →
          </a>
        </div>
      </article>

      <!-- Right column - list -->
      <div style="display: flex; flex-direction: column; gap: 16px;">
        <% articles.slice(1, 4).forEach(art => { %>
          <article style="background: #FFFFFF; border-radius: 16px; overflow: hidden; border: 1px solid var(--lf-border); display: flex; gap: 16px; padding: 16px; transition: all 0.25s;"
                   onmouseover="this.style.boxShadow='0 6px 20px rgba(22,48,31,0.07)'; this.style.borderColor='#86efac';"
                   onmouseout="this.style.boxShadow=''; this.style.borderColor='var(--lf-border)';">
            <a href="/blog/<%= art.slug %>" style="width: 100px; height: 100px; border-radius: 12px; overflow: hidden; flex-shrink: 0; display: block;">
              <img src="<%= art.thumbnail || 'https://images.unsplash.com/photo-1498837167922-ddd27525d352?auto=format&fit=crop&w=300&q=80' %>" 
                   alt="<%= art.title %>" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s;"
                   onmouseover="this.style.transform='scale(1.08)'" onmouseout="this.style.transform='scale(1)'">
            </a>
            <div style="display: flex; flex-direction: column; justify-content: center;">
              <span style="font-size: 11px; color: #256b40; font-weight: 800; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 6px;">
                <%= art.category ? art.category.name : 'MẸO SỐNG KHỎE' %>
              </span>
              <a href="/blog/<%= art.slug %>" style="font-size: 15px; font-weight: 700; color: #0f172a; text-decoration: none; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-bottom: 6px;">
                <%= art.title %>
              </a>
              <span style="font-size: 12px; color: #94a3b8;">
                <%= new Date(art.createdAt).toLocaleDateString('vi-VN') %>
              </span>
            </div>
          </article>
        <% }) %>
      </div>

    </div>

    <!-- Section header -->
    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 28px; flex-wrap: wrap; gap: 14px;">
      <div>
        <div style="font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 1.5px; color: #256b40; margin-bottom: 4px;">
          TẤT CẢ BÀI VIẾT
        </div>
        <h2 style="font-family: 'Lora', Georgia, serif; font-size: 26px; font-weight: 700; color: #16301f; margin: 0;">
          Cẩm Nang Sống Xanh & Dinh Dưỡng
        </h2>
      </div>
      <span style="font-size: 14px; color: #64748b; font-weight: 600;"><%= articles.length %> bài viết</span>
    </div>

    <!-- All articles grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px;">
      <% articles.slice(1).forEach(art => { %>
        <article style="background: #FFFFFF; border-radius: 20px; overflow: hidden; border: 1px solid var(--lf-border); display: flex; flex-direction: column; transition: all 0.3s;"
                 onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 10px 28px rgba(22,48,31,0.07)'; this.style.borderColor='#86efac';"
                 onmouseout="this.style.transform=''; this.style.boxShadow=''; this.style.borderColor='var(--lf-border)';">
          <div style="height: 200px; overflow: hidden; position: relative;">
            <a href="/blog/<%= art.slug %>">
              <img src="<%= art.thumbnail || 'https://images.unsplash.com/photo-1592417817098-8f3d69109853?auto=format&fit=crop&w=600&q=80' %>" 
                   alt="<%= art.title %>" 
                   style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s;"
                   onmouseover="this.style.transform='scale(1.06)'" onmouseout="this.style.transform='scale(1)'">
            </a>
          </div>
          <div style="padding: 22px; display: flex; flex-direction: column; flex: 1;">
            <span style="font-size: 11.5px; color: #256b40; font-weight: 800; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 8px;">
              <%= art.category ? art.category.name : 'Nông nghiệp sạch' %>
            </span>
            <a href="/blog/<%= art.slug %>" style="font-family: 'Lora', Georgia, serif; font-size: 19px; font-weight: 700; color: #16301f; text-decoration: none; margin-bottom: 10px; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
              <%= art.title %>
            </a>
            <p style="color: #64748b; font-size: 14px; margin-bottom: 18px; flex: 1; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.6;">
              <%= art.excerpt || '' %>
            </p>
            <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #f1f5f9; padding-top: 14px;">
              <span style="font-size: 12px; color: #94a3b8;"><%= new Date(art.createdAt).toLocaleDateString('vi-VN') %></span>
              <a href="/blog/<%= art.slug %>" style="font-weight: 700; color: #256b40; font-size: 13.5px; text-decoration: none; display: flex; align-items: center; gap: 4px;">
                Đọc tiếp →
              </a>
            </div>
          </div>
        </article>
      <% }) %>
    </div>

  <% } else { %>
    <div style="text-align: center; padding: 80px 20px; background: #FFFFFF; border-radius: 24px; border: 1px solid var(--lf-border);">
      <div style="font-size: 56px; margin-bottom: 16px;">🌿</div>
      <h3 style="font-family: 'Lora', Georgia, serif; font-size: 24px; font-weight: 700; color: #16301f; margin-bottom: 10px;">Đang cập nhật cẩm nang mới...</h3>
      <p style="color: #64748b; max-width: 440px; margin: 0 auto; font-size: 15px; line-height: 1.65;">
        Các bài viết kiến thức nông nghiệp hữu cơ và công thức nấu ăn lành mạnh sẽ sớm xuất hiện tại đây.
      </p>
    </div>
  <% } %>

</div>
